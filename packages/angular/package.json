{
  "name": "@vality/tsthrift-angular",
  "version": "0.0.0",
  "description": "Angular dependency injection, providers, and RxJS integration for tsthrift.",
  "homepage": "https://github.com/valitydev/tsthrift#readme",
  "bugs": {
    "url": "https://github.com/valitydev/tsthrift/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valitydev/tsthrift.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@vality/tsthrift": "workspace:*"
  },
  "devDependencies": {
    "@angular/core": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "rxjs": ">=7.0.0"
  }
}
