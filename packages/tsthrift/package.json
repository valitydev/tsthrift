{
  "name": "@vality/tsthrift",
  "version": "0.0.0",
  "description": "Thrift client, transport, and runtime for TypeScript and the web.",
  "homepage": "https://github.com/valitydev/tsthrift#readme",
  "bugs": {
    "url": "https://github.com/valitydev/tsthrift/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valitydev/tsthrift.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./angular": "./dist/angular/index.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "thrift": "catalog:"
  },
  "devDependencies": {
    "@angular/core": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  }
}
