{
  "name": "@vality/tsthrift-compiler",
  "version": "0.1.1",
  "description": "Environment-independent Thrift IDL compiler core: IDL to metadata and generated TypeScript sources in memory.",
  "homepage": "https://github.com/valitydev/tsthrift#readme",
  "bugs": {
    "url": "https://github.com/valitydev/tsthrift/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valitydev/tsthrift.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --sourcemap",
    "dev": "vp pack --watch --sourcemap",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@vality/tsthrift": "workspace:^",
    "thrift-parser": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
